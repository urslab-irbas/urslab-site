# ---- URSlab static site (Astro) — replaces the old WordPress rules ----
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Old WordPress addresses -> new pages (301 permanent)
RewriteRule ^състав/?$ /team/ [R=301,L]
RewriteRule ^проекти/?$ /projects/ [R=301,L]
RewriteRule ^участия/?$ /projects/ [R=301,L]
RewriteRule ^публикации/?$ /publications/ [R=301,L]
RewriteRule ^политика-за-бисквитки-ес/?$ / [R=301,L]
RewriteRule ^en_gb/?(.*)$ /en/ [R=301,L]

# Снимките (/images/…) се дават само на страници от сайта: директно отваряне на адреса, „hotlinking“
# от чужди сайтове и роботи за изображения получават 403. (Браузърът изпраща Referer при зареждане от страницата.)
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?urs\.ir\.bas\.bg/ [NC]
RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1)(:\d+)?/ [NC]
RewriteRule ^images/.+\.(jpe?g|png|webp|gif|avif)$ - [F,L,NC]

# Премахнати файлове (deploy-ът не трие на сървъра) — 410 Gone
RewriteRule ^docs/nspsd/(VVVU-2025-programa|IR-BRS-Dolna-may2025)\.pdf$ - [G,L,NC]

# WordPress no longer exists here: answer "410 Gone" to bots probing it
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-login\.php|xmlrpc\.php|wp-json) - [G,L]
</IfModule>

# Long cache for hashed build assets
<IfModule mod_headers.c>
  # снимките — без индексиране в търсачките за изображения
  <FilesMatch "\.(jpe?g|png|webp|gif|avif)$">
    Header set X-Robots-Tag "noimageindex, noindex"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
