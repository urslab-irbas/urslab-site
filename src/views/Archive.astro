---
// Годишна страница с публикации: списък с филтри и обобщение за отчет (данни: src/data/archivePages.ts)
import Layout from '../layouts/Layout.astro';
import { archiveCats, archiveTagLabels } from '../data/archive2022';
import { archivePages, type ArchivePage } from '../data/archivePages';
import { allPubs } from '../data/allPubs';
import { nspsdPubs } from '../data/nspsd';
import { expectedFor, expectedLabel, SJR_YEAR } from '../data/series';
import { areas, t, type Lang } from '../data/content';
import { team } from '../data/team';
import { href } from '../lib/i18n';
import { citationsFor, hiddenCitationsFor } from '../data/citations';
import { citRules, citPts } from '../data/citations/rules';
import { pubKey } from '../lib/pubSchema.js';
// page — годишна страница от archivePages; member — „Обобщен отчет“ за член от колектива;
// area — всички публикации от сайта в едно научно направление (картите в „Изследвания“)
// program — публикациите по проект (картата в „Проекти“): 'nspsd' = ННП „Сигурност и отбрана“ (src/data/nspsd.ts)
interface Props { lang: Lang; page?: string; member?: string; area?: string; program?: 'nspsd' }
const { lang, page, member, area, program } = Astro.props;
const M = member ? team.find((m) => m.id === member)! : undefined;
const A = area ? areas.find((a) => a.key === area)! : undefined;
const NSP: ArchivePage | undefined = program === 'nspsd' ? {
  key: 'nnp-so', slug: 'projects/nspsd',
  title: { bg: 'Публикации по ННП „Сигурност и отбрана“', en: 'Publications — NSP “Security and Defence”' },
  source: {
    bg: 'Източник: отчет на работните екипи в Института по роботика към БАН по ННП „Сигурност и отбрана“, Договор № Д01-74/19.05.2022 г. (редакция от 17.04.2026 г.), и технически доклад за периода 19.05.2022 – 31.12.2025 г. Изписването на публикациите е по записите на сайта.',
    en: 'Source: report of the Institute of Robotics (BAS) teams on the National Scientific Program “Security and Defence”, grant agreement No. D01-74/19.05.2022 (revision of 17 April 2026), and the technical report for 19 May 2022 – 31 December 2025. Publication details follow the records on this site.',
  },
  items: nspsdPubs,
} : undefined;
const P: ArchivePage = NSP ? NSP : M
  ? { key: M.id, slug: `team/${M.id}/report`, title: { bg: `Обобщен отчет — ${M.name.bg}`, en: `Summary report — ${M.name.en}` }, items: allPubs.filter((p) => p.team.includes(M.id)) }
  : A
    ? { key: A.key, slug: `publications/area/${A.key}`, title: { bg: `Публикации — ${A.title.bg}`, en: `Publications — ${A.title.en}` }, items: allPubs.filter((p) => p.tags.some((g) => A.tags.includes(g))) }
    : archivePages.find((x) => x.key === page)!;
const archive = P.items;
// Цитирания (само в „Обобщен отчет“): проверените цитирания на този член на колектива — src/data/citations/<id>/
const CIT = M ? citationsFor(M.id, archive) : undefined;
// Цитирания на трудове извън списъците на сайта (CitedWork.hidden) — в общия бутон „Цитирания“ (без филтър) и в група „Д“
const HID = M ? hiddenCitationsFor(M.id) : [];
const hidPts = HID.reduce((s, b) => s + b.pts, 0);
// „Точки НАЦИД“: таблицата и стратегията се пращат по имейл само на потребителя и на ръководителя (Б4) — не са на страницата
// „+ Цитиране“ — само за член с GitHub акаунт (заявката се приема само от неговия акаунт или от ръководителя)
const canAdd = !!M?.github;
const bg = lang === 'bg';
const T = (b: string, e: string) => (bg ? b : e);
const title = P.title[lang];
const hasShare = archive.some((p) => p.share !== undefined);
const isIx = (p: { cat: string; ix?: boolean }) => !!p.ix || ['q1', 'q2', 'q3', 'q4', 'sjr', 'idx'].includes(p.cat);
const usedCats = archiveCats.filter((c) => archive.some((p) => p.cat === c.key));

const short = (n: string) => { const w = n.split(' '); return `${w[0][0]}. ${w[w.length - 1]}`; };
const authors = [
  ...team.map((m) => ({ key: m.id, label: short(m.name[lang]) })),
  { key: 'yovchev', label: T('К. Йовчев', 'K. Yovchev') },
  ...(NSP ? [{ key: 'valchkova', label: T('Н. Вълчкова', 'N. Valchkova') }, { key: 'zahariev', label: T('Р. Захариев', 'R. Zahariev') }] : []),
].filter((a) => a.key !== M?.id && archive.some((p) => p.team.includes(a.key)));
const years = [...new Set(archive.map((p) => p.year))].sort((a, b) => b - a);
const usedTags = Object.keys(archiveTagLabels).filter((g) => archive.some((p) => p.tags.includes(g)));
const areaBtns = areas.map((a) => ({ ...a, n: archive.filter((p) => p.tags.some((g) => a.tags.includes(g))).length }));
const catLabel = Object.fromEntries(archiveCats.map((c) => [c.key, c.label[lang]]));
const groups = archiveCats.map((c) => ({ ...c, items: archive.filter((p) => p.cat === c.key).sort((a, b) => b.year - a.year) })).filter((g) => g.items.length);
const authorLabel = Object.fromEntries(authors.map((a) => [a.key, a.label]));
const L = {
  total: T('Публикации', 'Publications'),
  indexed: T('в WoS/Scopus', 'in WoS/Scopus'),
  withQ: T('с квартил (Q1–Q4)', 'with quartile (Q1–Q4)'),
  sjr: T('Σ SJR', 'Σ SJR'),
  jif: T('Σ IF (JCR)', 'Σ IF (JCR)'),
  doi: T('с DOI', 'with DOI'),
};
---
<Layout lang={lang} slug={P.slug} title={title}
  description={T(`${title} — лаборатория „Безпилотни роботизирани системи“: филтри и обобщение по квартили и SJR.`, `${title} — Unmanned Robotic Systems Laboratory: filters and a summary by quartile and SJR.`)}>
  <header class="page-head"><div class="wrap">
    {M
      ? <p class="eyebrow"><a href={`${href(lang, 'team')}#${M.id}`}>{t.team[lang]}</a> / {M.title[lang]}</p>
      : A ? <p class="eyebrow"><a href={href(lang, 'research')}>{T('Изследвания', 'Research')}</a> / {t.areasTitle[lang]}</p>
      : NSP ? <p class="eyebrow"><a href={href(lang, 'projects')}>{T('Проекти', 'Projects')}</a> / {T('ННП „Сигурност и отбрана“', 'NSP “Security and Defence”')}</p>
      : <p class="eyebrow"><a href={href(lang, 'publications')}>{t.allPubs[lang]}</a> / URSlab</p>}
    <h1>{title}</h1>
    <p>{NSP
      ? T('Публикациите на работните екипи в Института по роботика към БАН при изпълнение на задачите по Национална научна програма „Сигурност и отбрана“ (Договор № Д01-74/19.05.2022 г., МОН), групирани по вид и индексиране. Комбинирайте филтрите — обобщението се преизчислява за избраното.', 'Publications of the Institute of Robotics (BAS) teams produced under the National Scientific Program “Security and Defence” (grant agreement No. D01-74/19.05.2022, Ministry of Education and Science), grouped by type and indexing. Combine the filters — the summary is recomputed for the selection.')
      : A
      ? T('Всички публикации от сайта в това научно направление — годишните страници от „Архив“, текущият списък и въведените от колектива, без повторения. Броят се обновява автоматично с всяка нова публикация.', 'All publications on this site in this research area — the yearly archive pages, the current list and those entered by the team, without duplicates. The count updates automatically with every new publication.')
      : M
      ? T('Всички публикации от сайта с участието на този потребител — годишните страници от „Архив“ и текущият списък, без повторения. Комбинирайте филтрите — обобщението се преизчислява за избраното.', 'All publications on this site co-authored by this team member — the yearly archive pages and the current list, without duplicates. Combine the filters — the summary is recomputed for the selection.')
      : T('Пълен списък на публикациите на колектива, групирани по вид и индексиране. Комбинирайте филтрите — обобщението отдолу се преизчислява за избраното.', 'Full list of the team’s publications, grouped by type and indexing. Combine the filters — the summary below is recomputed for the selection.')}</p>
  </div></header>

  <section class="block"><div class="wrap" data-arch>
    <div class="frow" hidden={!!A}>
      <span class="lbl">{t.byArea[lang]}</span>
      <div class="filters" data-g="area">
        <button type="button" data-v="" aria-pressed="true">{t.all[lang]}</button>
        {areaBtns.map((a) => <button type="button" data-v={a.tags.join(' ') || '__none__'} aria-pressed="false" disabled={a.n === 0}>{a.title[lang]} <span class="n">{a.n}</span></button>)}
      </div>
    </div>
    <div class="frow">
      <span class="lbl">{t.byTopic[lang]}</span>
      <div class="filters" data-g="tag">
        <button type="button" data-v="" aria-pressed="true">{t.all[lang]}</button>
        {usedTags.map((g) => <button type="button" data-v={g} aria-pressed="false">{archiveTagLabels[g][lang]}</button>)}
      </div>
    </div>
    <div class="frow">
      <span class="lbl">{T('Индексиране', 'Indexing')}</span>
      <div class="filters" data-g="cat">
        <button type="button" data-v="" aria-pressed="true">{t.all[lang]}</button>
        <button type="button" data-v="__ix__" aria-pressed="false">WoS/Scopus</button>
        <button type="button" data-v="q1 q2 q3 q4" aria-pressed="false">Q1–Q4</button>
        {usedCats.map((c) => <button type="button" data-v={c.key} aria-pressed="false">{c.label[lang]}</button>)}
      </div>
    </div>
    <div class="frow" hidden={years.length < 2}>
      <span class="lbl">{T('Година', 'Year')}</span>
      <div class="filters" data-g="year">
        <button type="button" data-v="" aria-pressed="true">{t.all[lang]}</button>
        {years.map((y) => <button type="button" data-v={String(y)} aria-pressed="false">{y}</button>)}
      </div>
    </div>
    <div class="frow" hidden={authors.length === 0}>
      <span class="lbl">{M ? T('Съавтор', 'Co-author') : T('Автор', 'Author')}</span>
      <div class="filters" data-g="team">
        <button type="button" data-v="" aria-pressed="true">{t.all[lang]}</button>
        {authors.map((a) => <button type="button" data-v={a.key} aria-pressed="false">{a.label}</button>)}
      </div>
    </div>

    <div class="sum" aria-live="polite">
      <div class="sum-head">
        <h2>{T('Обобщение за отчет', 'Summary for reporting')}</h2>
        <div class="acts">
          {CIT && canAdd && <a class="btn-s" href={`https://github.com/urslab-irbas/urslab-site/issues/new?${new URLSearchParams({ title: `[Търсене на цитирания] ${M!.name.bg}`, body: `Потребител: ${M!.id}\n\nРъчно търсене на нови цитирания на трудовете на колектива (OpenAlex, OpenCitations, Semantic Scholar и списанията на БАН). Натиснете „Create“ — търсенето трае около 20–25 минути; резултатът идва като заявка „[Нови цитирания] …“ и по имейл до потребителя и до ръководителя. Заявката се приема само от акаунта на потребителя или на ръководителя; най-много веднъж на 24 часа.` }).toString()}`} target="_blank" rel="noopener" title={T('Търсене на нови цитирания в OpenAlex, OpenCitations, Semantic Scholar и списанията на БАН — около 20–25 минути. Резултатът — заявка в GitHub и имейл до потребителя и до ръководителя (вход с акаунта на потребителя или на ръководителя; най-много веднъж на 24 часа)', 'Search for new citations in OpenAlex, OpenCitations, Semantic Scholar and the BAS journals — about 20–25 minutes. The result is a GitHub request and an e-mail to the user and the head of the lab (sign in with the user’s or the head’s account; at most once per 24 hours)')}>{T('Търси нови цитирания', 'Search for new citations')}</a>}
          {CIT && canAdd && <a class="btn-s" href="/docs/URSlab-citirania.pdf" target="_blank" rel="noopener">{T('Помощ: цитирания', 'Help: citations')}</a>}
          {CIT && <button type="button" class="btn-s btn-c" data-cits-all title={T('Всички цитирания на избраните публикации по образеца на НАЦИД', 'All citations of the selected publications in the NACID format')}>{T('Цитирания', 'Citations')} <b data-s="cpts">0</b></button>}
          {NSP && <a class="btn-s btn-x" href="/docs/NNPSO_Publications_IR-BAS.xlsx" download title={T('Таблицата по образеца на ННП „Сигурност и отбрана“ (Excel)', 'The table in the NSP “Security and Defence” template (Excel)')}>{T('Експорт към ННП „СО“ (Excel)', 'Export for NSP DS (Excel)')}</a>}
          {NSP && <a class="btn-s" href="https://nsp.secade.bg/bg/rezultati/publikacii" target="_blank" rel="noopener">{T('Публикации на ННП „СО“ ↗', 'NSP DS publications ↗')}</a>}
          <button type="button" class="btn-s" data-csv>{T('Изтегли CSV', 'Download CSV')}</button>
          <button type="button" class="btn-s" data-print>{T('Печат', 'Print')}</button>
          <button type="button" class="btn-s" data-reset>{T('Изчисти филтрите', 'Clear filters')}</button>
        </div>
      </div>
      <div class="tiles">
        <div><b data-s="total"></b><span>{L.total}</span></div>
        <div><b data-s="indexed"></b><span>{L.indexed}</span></div>
        <div><b data-s="withQ"></b><span>{L.withQ}</span></div>
        <div><b data-s="sjr"></b><span>{L.sjr}</span></div>
        <div><b data-s="jif"></b><span>{L.jif}</span></div>
        <div><b data-s="doi"></b><span>{L.doi}</span></div>
        {hasShare && <div class="tip" tabindex="0" data-tip={T('Процент автори от ИР: средният дял на авторите от ИР в избраните публикации (дробно броене, в %). Дялът на всяка публикация е по отчета на БАН, а където го няма — изчислен: автори от ИР ÷ всички автори. Членовете на колектива се броят като автори от ИР за всички свои публикации, вкл. издадени при друг работодател. Подадените / под печат не се включват.', 'Percentage of IR authors: the average share of IR authors in the selected publications (fractional counting, in %). Each publication’s share is taken from the BAS report or, where missing, computed as IR authors ÷ all authors. Team members count as IR authors for all their publications, including those issued under another employer. Submitted / in-press items are not included.')}><b data-s="share"></b><span>{T('Процент автори ИР', 'Percentage of IR authors')} <abbr class="hint" aria-hidden="true">ⓘ</abbr></span></div>}
        {M && <div class="nac tip" tabindex="0" data-tip={T('Таблицата „Изисквания … и точки“ по групи А–Е (Минимални национални изисквания, Област 5) и стратегията за целевата длъжност се изпращат по имейл само на потребителя и на ръководителя — не се показват на сайта. Бутонът отваря заявка в GitHub (вход с акаунта на потребителя или на ръководителя); натиснете „Create“ — писмото с PDF идва до 2–3 минути.', 'The table “Requirements … and points” by groups A–E (Minimum National Requirements, Area 5) and the strategy for the target position are e-mailed only to the user and the head of the lab — they are not shown on the site. The button opens a GitHub request (sign in with the user’s or the head’s account); press “Create” — the e-mail with the PDF arrives within 2–3 minutes.')}><b>✉</b><span>{T('Точки НАЦИД', 'NACID points')}</span><a class="btn-s nac-btn" href={`https://github.com/urslab-irbas/urslab-site/issues/new?${new URLSearchParams({ title: `[Точки НАЦИД] ${M.name.bg}`, body: `Потребител: ${M.id}\n\nТаблицата „Точки НАЦИД“ и стратегията се изпращат по имейл само на потребителя и на ръководителя. Натиснете „Create“ — писмото с PDF идва до 2–3 минути. Заявката се приема само от акаунта на потребителя или на ръководителя; в нея не се публикуват числа.` }).toString()}`} target="_blank" rel="noopener">{T('Таблица по имейл', 'Table by e-mail')}</a></div>}
      </div>
      <div class="breakdown">
        <div><h3>{T('По вид / квартил', 'By type / quartile')}</h3><table data-t="cat"></table></div>
        <div><h3>{T('По година', 'By year')}</h3><table data-t="year"></table></div>
        <div><h3>{M ? T('Съавтори от колектива', 'Co-authors from the team') : T('Участие на колектива', 'Team participation')}</h3><table data-t="team"></table></div>
      </div>
    </div>

    {groups.map((g) => (
      <section class="grp" data-grp={g.key}>
        <h2>{/^q\d$/.test(g.key) ? `WoS/Scopus — ${g.label[lang]}` : g.label[lang]} <span class="gc" data-gc></span></h2>
        <ol class={`alist${CIT ? ' wc' : ''}`}>
          {g.items.map((p) => { const cb = CIT?.get(p); const showCit = CIT && p.cat !== 'sub'; return (
            <li data-cpts={cb?.pts ?? 0} data-cno={cb?.work.no ?? ''} data-key={showCit ? pubKey(p) : ''} data-year={p.year} data-cat={p.cat} data-tags={p.tags.join(' ')} data-team={p.team.join(' ')}
                data-ix={isIx(p) ? '1' : ''} data-share={p.share ?? ''} data-sjr={p.sjr ?? ''} data-jif={p.jif ?? ''} data-doi={p.doi ?? ''} data-isbn={p.isbn ?? (p.issn ? `ISSN ${p.issn}` : '')}
                data-authors={!bg && p.authorsEn ? p.authorsEn : p.authors} data-title={p.title} data-venue={p.venue}>
              <div class="yc"><span class="yr">{p.year}</span>
                {showCit && <button type="button" class="cbtn" data-cit disabled={!cb && !canAdd} title={cb ? T('Проверените цитирания на тази публикация', 'Verified citations of this publication') : canAdd ? T('Още няма въведени цитирания — отворете, за да въведете', 'No citations entered yet — open to enter one') : T('Още няма въведени цитирания', 'No citations entered yet')}><span>{T('Цитирания', 'Citations')}</span> <b>{cb?.pts ?? 0}</b></button>}
              </div>
              {showCit && <template data-cits><section class="cw">
                <h3>{cb && <>{cb.work.no}. </>}{!bg && p.authorsEn ? p.authorsEn : p.authors} {p.title}{!bg && p.tr && <> [{p.tr}]</>}. {p.venue}{p.isbn && <>, ISBN {p.isbn}</>}{p.doi && <>, DOI {p.doi}</>}</h3>
                {!cb ? <p class="muted">{T('Още няма въведени цитирания за този труд.', 'No citations entered for this work yet.')}</p> : <table class="ct">
                  <thead><tr><th>№</th><th>{T('Цитиращ източник', 'Citing source')}</th><th>{T('Показател', 'Indicator')}</th><th>{T('Точки', 'Points')}</th></tr></thead>
                  <tbody>{cb.work.cites.map((c, i) => (
                    <tr><td>{cb.work.no}.{i + 1}</td>
                      <td>{c.text}{c.where && <> ({T('цитирано', 'cited')}: {c.where})</>}{c.doi && <>, DOI <a href={`https://doi.org/${c.doi}`}>{c.doi}</a></>}{c.url && <> · <a href={c.url} target="_blank" rel="noopener">{T('Линк', 'Link')}</a></>}{c.note && <span class="cn">{c.note}</span>}{c.evidence && <span class="cn">{T('Доказателство', 'Evidence')}: {c.evidence}{c.evidenceUrl && <> · <a href={c.evidenceUrl} target="_blank" rel="noopener">{T('отвори', 'open')}</a></>}</span>}<span class="mi">{T('Д', 'D')}-{c.ind}</span></td>
                      <td>{T('Д', 'D')}-{c.ind}</td><td>{citPts(c.ind)}</td></tr>
                  ))}</tbody>
                  <tfoot><tr><td colspan="3">{T('Общо за труда', 'Total for this work')} ({cb.work.cites.length} {T('цитирания', 'citations')})</td><td>{cb.pts}</td></tr></tfoot>
                </table>}
              </section></template>}
              <div>
                <p class="au">{!bg && p.authorsEn ? p.authorsEn : p.authors}</p>
                <h3>{p.page ? <a href={href(lang, p.page)}>{p.title}</a> : p.doi && !p.doiOff ? <a href={`https://doi.org/${p.doi}`}>{p.title}</a> : p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
                {!bg && p.tr && <p class="tr">[{p.tr}]</p>}
                <p class="ve">{p.venue}{p.isbn && <> · ISBN {p.isbn}</>}{p.issn && <> · ISSN {p.issn}</>}{p.doi && (p.doiOff ? <> · DOI {p.doi} <span class="doi-off">({T('още не е активен', 'not yet active')})</span></> : <> · DOI <a href={`https://doi.org/${p.doi}`}>{p.doi}</a></>)}{p.eid && <> · Scopus <a href={`https://www.scopus.com/inward/record.uri?eid=${p.eid}`}>{p.eid}</a></>}{p.scopusAuthor && <> · Scopus Author ID <a href={`https://www.scopus.com/inward/authorDetails.url?authorID=${p.scopusAuthor}&partnerID=MN8TOARS`}>{p.scopusAuthor}</a></>}</p>
                <p class="badges">
                  <span class={`q ${p.cat}`}>{catLabel[p.cat]}</span>
                  {p.cat === 'sub' && expectedFor(p.venue) && (() => { const e = expectedFor(p.venue)!; return <a class={`exp ${e.cat}`} href={e.url} title={e.name}>{T('Очаквано', 'Expected')}: {expectedLabel(e, lang)}{!e.text && <span> ({SJR_YEAR})</span>}</a>; })()}
                  {p.sjr !== undefined && <span class="m">SJR {p.sjr}</span>}
                  {p.jif !== undefined && <span class="m">IF {p.jif}</span>}
                  {p.ix && <span class="m">WoS/Scopus</span>}
                  {p.share !== undefined && <span class="m tip" tabindex="0" data-tip={p.shareCalc ? T('Изчислен: автори от ИР ÷ всички автори', 'Computed: IR authors ÷ all authors') : T('По отчета на БАН („Процент автори от звеното“)', 'From the BAS report (“percentage of authors from the unit”)')}>{T('автори ИР', 'IR authors')} {p.share}%{p.shareCalc && '*'}</span>}
                  {p.note && <span class="m">({p.note})</span>}
                  {p.fund && <span class="fund">{p.fundVia === 'conf' ? T('Участие в конференцията, финансирано по', 'Conference participation funded by') : p.fundVia === 'report' ? T('Отчетено по', 'Reported under') : T('Финансиране', 'Funding')}: {p.fund}</span>}
                  {p.task && <span class="m">{T('Задача', 'Task')} {p.task}</span>}
                  {p.tags.map((x) => <span class="tag">{archiveTagLabels[x]?.[lang] ?? x}</span>)}
                </p>
              </div>
            </li>
          ); })}
        </ol>
      </section>
    ))}
    <p class="none" hidden>{t.noneFound[lang]}</p>
    {CIT && <dialog class="cdlg" data-cdlg aria-labelledby="cd-title">
      <div class="cd-head"><h2 id="cd-title" data-cd-title></h2><div class="cd-acts">{canAdd && <a class="btn-s btn-add" data-cd-add hidden href={`${href(lang, 'publications/new')}?m=${M!.id}`} title={T('Въвеждане на ново цитиране на този труд (вход с GitHub; само потребителят или ръководителят)', 'Enter a new citation of this work (GitHub sign-in; the team member or the head of the lab only)')}>+ {T('Цитиране', 'Citation')}</a>}<button type="button" class="btn-s" data-cd-close>{T('Затвори', 'Close')}</button></div></div>
      <div data-cd-body></div>
      <p class="cd-total" data-cd-total></p>
      <p class="cd-legend">{T('Точки по Минималните национални изисквания (ППЗРАСРБ, Таблица 2, група „Д“), Област 5 „Технически науки“:', 'Points under the Minimum National Requirements (Table 2, group D), Area 5 “Technical Sciences”:')}{Object.values(citRules).map((r) => <span>{r.label[lang]} — {r.pts} {T('т.', 'pts')}</span>)}{T('Самоцитиранията не се включват.', 'Self-citations are not included.')}</p>
    </dialog>}
    {HID.length > 0 && <div hidden data-hid data-hpts={hidPts}>{HID.map((b) => (
      <template data-hcits data-cno={b.work.no}><section class="cw">
        <h3>{b.work.no}. {b.work.hidden!.text}</h3>
        <table class="ct">
          <thead><tr><th>№</th><th>{T('Цитиращ източник', 'Citing source')}</th><th>{T('Показател', 'Indicator')}</th><th>{T('Точки', 'Points')}</th></tr></thead>
          <tbody>{b.work.cites.map((c, i) => (
            <tr><td>{b.work.no}.{i + 1}</td>
              <td>{c.text}{c.doi && <>, DOI <a href={`https://doi.org/${c.doi}`}>{c.doi}</a></>}{c.url && <> · <a href={c.url} target="_blank" rel="noopener">{T('Линк', 'Link')}</a></>}{c.note && <span class="cn">{c.note}</span>}<span class="mi">{T('Д', 'D')}-{c.ind}</span></td>
              <td>{T('Д', 'D')}-{c.ind}</td><td>{citPts(c.ind)}</td></tr>
          ))}</tbody>
          <tfoot><tr><td colspan="3">{T('Общо за труда', 'Total for this work')} ({b.work.cites.length} {T('цитирания', 'citations')})</td><td>{b.pts}</td></tr></tfoot>
        </table>
      </section></template>
    ))}</div>}
    {P.source && <p class="src">{P.source[lang]}</p>}
    <script type="application/json" data-labels set:html={JSON.stringify({ cats: catLabel, team: authorLabel, csvName: T(`publikacii-${P.key}`, `publications-${P.key}`), cit: { one: T('Цитирания на', 'Citations of'), all: T('Цитирания на избраните публикации (по образеца на НАЦИД)', 'Citations of the selected publications (NACID format)'), total: T('Общо за избраните публикации', 'Total for the selected publications'), n: T('цитирания', 'citations'), pts: T('точки', 'points'), none: T('Няма въведени цитирания за избраните публикации.', 'No citations entered for the selected publications.') } })} />
  </div></section>
</Layout>

<style>
  .eyebrow a { color: inherit; }
