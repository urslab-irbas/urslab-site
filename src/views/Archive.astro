  .cbtn b { font-size: .95rem; }
  .cbtn:hover:not(:disabled) { background: var(--accent); color: #fff; }
  .cbtn:disabled { border-color: var(--line); color: var(--muted); cursor: default; }
  .btn-c b { margin-left: 2px; }
  .cdlg { width: min(1100px, calc(100vw - 32px)); max-height: calc(100vh - 48px); padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text); }
  .cdlg::backdrop { background: rgba(8, 16, 26, .6); }
  .cd-head { display: flex; justify-content: space-between; align-items: start; gap: 16px; margin-bottom: 12px; }
  .cd-head h2 { font-size: 1.15rem; margin: 0; }
  .cd-acts { display: flex; gap: 8px; flex-shrink: 0; }
  .btn-add { background: var(--accent); color: #fff !important; }
  .btn-add[hidden] { display: none; }
  .cw { margin: 0 0 22px; }
  .cw h3 { font-size: .95rem; font-weight: 600; margin: 0 0 8px; line-height: 1.45; }
  .ct { width: 100%; border-collapse: collapse; font-size: .88rem; }
  .ct th, .ct td { border: 1px solid var(--line); padding: 6px 8px; text-align: left; vertical-align: top; }
  .ct th { font: .72rem var(--mono); text-transform: uppercase; letter-spacing: .04em; color: var(--muted); background: var(--paper); }
  .ct td:first-child, .ct td:nth-child(3) { white-space: nowrap; font-family: var(--mono); font-size: .8rem; }
  .ct td:last-child, .ct th:last-child { text-align: right; white-space: nowrap; font-weight: 600; }
  .ct tfoot td { font-weight: 600; background: var(--paper); }
  .ct th { white-space: nowrap; }
  .ct .mi { display: none; }
  .ct .cn { display: block; margin-top: 4px; font-size: .8rem; color: var(--muted); font-style: italic; }
  .cd-total { font-weight: 700; margin: 4px 0 12px; }
  .cd-legend { font-size: .78rem; color: var(--muted); margin: 0; }
  .cd-legend span { display: block; }
  .tiles .nac { position: relative; }
  .nac-btn { margin-top: 6px; font-size: .74rem; padding: 2px 10px; }
  .nac-wrap { overflow-x: auto; }
  .nt td:nth-child(n+3), .nt th:nth-child(n+3) { text-align: center; white-space: nowrap; font-family: var(--mono); }
  .nt td:last-child { text-align: right; }
  .nt td:first-child { font-family: inherit; font-weight: 600; }
  .nt td:nth-child(3) { font-size: inherit; }
  .cd-legend p { margin: 6px 0 0; }
  .nt { min-width: 640px; }
  @media (max-width: 600px) { .ct.nt th:nth-child(3), .ct.nt td:nth-child(3) { display: table-cell; } }
  @media (max-width: 600px) { .yc { flex-direction: row; align-items: center; } .cbtn { flex-direction: row; gap: 6px; } .cdlg { padding: 16px; width: calc(100vw - 16px); } .ct { font-size: .82rem; } .ct th:nth-child(3), .ct td:nth-child(3) { display: none; } .ct .mi { display: block; margin-top: 4px; font: .72rem var(--mono); color: var(--muted); } .ct th, .ct td { padding: 5px 6px; } }
  .au { margin: 0; font-size: .9rem; color: var(--muted); }
  .alist h3 { font-size: 1rem; margin: 2px 0; line-height: 1.4; }
  .alist h3 a { color: inherit; }
  .tr { margin: 0; font-size: .9rem; color: var(--muted); }
  .ve { margin: 0; font-size: .88rem; font-style: italic; color: var(--muted); }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; align-items: center; }
  .q { font: 600 .72rem var(--mono); padding: 2px 8px; border-radius: 4px; background: var(--line); color: var(--text); }
  .q.q1 { background: #2e7d4f; color: #fff; } .q.q2 { background: #4f9a5f; color: #fff; }
  .q.q3 { background: #c79a2a; color: #fff; } .q.q4 { background: #d27a2c; color: #fff; }
  .m { font: .72rem var(--mono); color: var(--muted); }
  .exp { font: 600 .72rem var(--mono); padding: 2px 8px; border-radius: 4px; border: 1px dashed currentColor; text-decoration: none; color: var(--accent-ink); }
  .exp.q1 { color: #2e7d4f; } .exp.q2 { color: #4f9a5f; } .exp.q3 { color: #a77d1a; } .exp.q4 { color: #c0661c; }
  .exp span { font-weight: 400; opacity: .7; }
  .fund { font: .72rem var(--mono); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--accent); color: var(--accent-ink); }
  .none { color: var(--muted); padding: 20px 0; }
  .none[hidden] { display: none; }
  .src { margin-top: 32px; font-size: .82rem; color: var(--muted); }
  @media (max-width: 900px) { .breakdown { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .frow { grid-template-columns: 1fr; gap: 4px; } .alist li, .alist.wc li { grid-template-columns: 1fr; gap: 6px; } }
  @media print {
    :global(header.top), :global(footer), .frow, .acts, :global(.page-head p) { display: none !important; }
    .sum { break-inside: avoid; }
    .alist li { break-inside: avoid; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-arch]')!;
  const labels = JSON.parse(root.querySelector('[data-labels]')!.textContent!);
  const items = [...root.querySelectorAll<HTMLLIElement>('.alist li')];
  const sel: Record<string, string> = { area: '', tag: '', cat: '', year: '', team: '' };
  const fmt = (x: number) => (Math.round(x * 1000) / 1000).toLocaleString(document.documentElement.lang === 'bg' ? 'bg-BG' : 'en-GB');

  function match(li: HTMLLIElement) {
    const d = li.dataset, tags = (d.tags ?? '').split(' '), team = (d.team ?? '').split(' ');
    const any = (v: string, arr: string[]) => !v || v.split(' ').some((x) => arr.includes(x));
    const catOk = sel.cat === '__ix__' ? d.ix === '1' : any(sel.cat, [d.cat!]);
    return any(sel.area, tags) && any(sel.tag, tags) && catOk && any(sel.year, [d.year!]) && any(sel.team, team);
  }
  function table(name: string, rows: [string, number][]) {
    root.querySelector(`[data-t="${name}"]`)!.innerHTML = rows.map(([k, n]) => `<tr class="${n ? '' : 'z'}"><td>${k}</td><td>${n}</td></tr>`).join('');
  }
  function update() {
    let shown: HTMLLIElement[] = [];
    items.forEach((li) => { li.hidden = !match(li); if (!li.hidden) shown.push(li); });
    root.querySelectorAll<HTMLElement>('[data-grp]').forEach((g) => {
      const n = g.querySelectorAll('li:not([hidden])').length;
      g.hidden = n === 0; g.querySelector('[data-gc]')!.textContent = `(${n})`;
    });
    root.querySelector<HTMLElement>('.none')!.hidden = shown.length > 0;
    const c = (f: (d: DOMStringMap) => boolean) => shown.filter((li) => f(li.dataset)).length;
    const sum = (k: 'sjr' | 'jif') => shown.reduce((s, li) => s + (Number(li.dataset[k]) || 0), 0);
    const set = (k: string, v: string | number) => (root.querySelector(`[data-s="${k}"]`)!.textContent = String(v));
    set('total', shown.length);
    set('indexed', c((d) => d.ix === '1'));
    set('withQ', c((d) => /^q[1-4]$/.test(d.cat!)));
    set('sjr', fmt(sum('sjr'))); set('jif', fmt(sum('jif')));
    set('doi', c((d) => !!d.doi));
    // „Цитирания“: + цитиранията на трудовете извън списъците на сайта (само без избран филтър)
    const hid = root.querySelector<HTMLElement>('[data-hid]');
    const noFilter = Object.values(sel).every((x) => !x);
    if (root.querySelector('[data-s="cpts"]')) set('cpts', shown.filter((li) => li.dataset.cat !== 'sub').reduce((s, li) => s + (Number(li.dataset.cpts) || 0), 0) + (hid && noFilter ? Number(hid.dataset.hpts) || 0 : 0));
    // Процент автори ИР = средният дял на авторите от ИР в публикациите с дял (дробно броене, в %)
    if (root.querySelector('[data-s="share"]')) {
      const w = shown.filter((li) => li.dataset.share !== '' && li.dataset.cat !== 'sub');
      const pct = w.length ? w.reduce((s, li) => s + Number(li.dataset.share), 0) / w.length : 0;
      set('share', w.length ? `${(Math.round(pct * 10) / 10).toLocaleString(document.documentElement.lang === 'bg' ? 'bg-BG' : 'en-GB')} %` : '—');
    }
    table('cat', Object.entries(labels.cats as Record<string, string>).filter(([k]) => items.some((li) => li.dataset.cat === k)).map(([k, l]) => [l, c((d) => d.cat === k)]));
    const years = [...new Set(items.map((li) => li.dataset.year!))].sort().reverse();
    table('year', years.map((y) => [y, c((d) => d.year === y)]));
    table('team', Object.entries(labels.team as Record<string, string>).map(([k, l]) => [l, c((d) => (d.team ?? '').split(' ').includes(k))]));
  }
  root.querySelectorAll<HTMLElement>('[data-g]').forEach((grp) => {
    grp.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b || b.disabled) return;
      sel[grp.dataset.g!] = b.dataset.v ?? '';
      grp.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      update();
    });
  });
  root.querySelector('[data-reset]')!.addEventListener('click', () => {
    Object.keys(sel).forEach((k) => (sel[k] = ''));
    root.querySelectorAll<HTMLElement>('[data-g]').forEach((g) => g.querySelectorAll('button').forEach((x, i) => x.setAttribute('aria-pressed', String(i === 0))));
    update();
  });
  root.querySelector('[data-print]')!.addEventListener('click', () => window.print());
  // Цитирания: бутонът под годината — само тази публикация; бутонът в „Обобщение за отчет“ — всички избрани
  const dlg = root.querySelector<HTMLDialogElement>('[data-cdlg]');
  if (dlg) {
    const body = dlg.querySelector<HTMLElement>('[data-cd-body]')!, total = dlg.querySelector<HTMLElement>('[data-cd-total]')!;
    const addBtn = dlg.querySelector<HTMLAnchorElement>('[data-cd-add]');
    const open = (title: string, lis: HTMLLIElement[], showTotal: boolean, key = '') => {
      body.innerHTML = '';
      // „+ Цитиране“ — само при отваряне от бутона под годината на конкретна публикация
      if (addBtn) { addBtn.hidden = !key; if (key) { const u = new URL(addBtn.href, location.href); u.searchParams.set('cite', key); addBtn.href = u.pathname + u.search; } }
      const withCit = lis.filter((li) => li.querySelector('template[data-cits]') && (key || Number(li.dataset.cpts) > 0));
      // общият бутон без филтър: и трудовете извън списъците на сайта (по номер)
      const hidT = showTotal && Object.values(sel).every((x) => !x) ? [...root.querySelectorAll<HTMLTemplateElement>('[data-hid] template[data-hcits]')] : [];
      const parts: [number, HTMLTemplateElement][] = [
        ...withCit.map((li) => [Number(li.dataset.cno), li.querySelector<HTMLTemplateElement>('template[data-cits]')!] as [number, HTMLTemplateElement]),
        ...hidT.map((t) => [Number(t.dataset.cno), t] as [number, HTMLTemplateElement]),
      ].sort((a, b) => a[0] - b[0]);
      parts.forEach(([, t]) => body.append(t.content.cloneNode(true)));
      if (!parts.length) body.innerHTML = `<p>${labels.cit.none}</p>`;
      const pts = withCit.reduce((s, li) => s + (Number(li.dataset.cpts) || 0), 0) + (hidT.length ? Number(root.querySelector<HTMLElement>('[data-hid]')!.dataset.hpts) || 0 : 0);
      const n = body.querySelectorAll('tbody tr').length;
      total.hidden = !showTotal || !parts.length;
      total.textContent = `${labels.cit.total}: ${n} ${labels.cit.n}, ${pts} ${labels.cit.pts}`;
      dlg.querySelector('[data-cd-title]')!.textContent = title;
      dlg.showModal();
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cit]');
      if (!b || b.disabled) return;
      const li = b.closest('li')!;
      open(`${labels.cit.one}: ${li.dataset.title}`, [li], false, li.dataset.key);
    });
    root.querySelector('[data-cits-all]')!.addEventListener('click', () => open(labels.cit.all, items.filter((li) => !li.hidden && li.dataset.cat !== 'sub'), true));
    dlg.querySelector('[data-cd-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
  root.querySelector('[data-csv]')!.addEventListener('click', () => {
    const q = (s: string) => `"${s.replace(/"/g, '""')}"`;
    const head = ['Year', 'Category', 'Authors', 'Title', 'Venue', 'DOI', 'ISBN', 'SJR', 'IF (JCR)', 'WoS/Scopus', 'IR authors %'];
    const rows = items.filter((li) => !li.hidden).map((li) => {
      const d = li.dataset;
      return [d.year!, labels.cats[d.cat!], d.authors!, d.title!, d.venue!, d.doi!, d.isbn!, d.sjr!, d.jif!, d.ix ? 'yes' : '', d.share!].map(q).join(',');
    });
    const blob = new Blob(['﻿' + [head.map(q).join(','), ...rows].join('\r\n')], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = labels.csvName + '.csv'; a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  update();
</script>
