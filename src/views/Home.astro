---
import Layout from '../layouts/Layout.astro';
import ClothoidDemo from '../components/ClothoidDemo.astro';
import PubList from '../components/PubList.astro';
import Gallery from '../components/Gallery.astro';
import AreaCard from '../components/AreaCard.astro';
import { site, areas, t, nav, type Lang } from '../data/content';
import { currentList, archiveList } from '../data/allPubs';
import { team } from '../data/team/index';
import { href } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const latest = [...currentList, ...archiveList].slice(0, 3);
---
<Layout lang={lang} slug="">
  <section class="hero">
    <svg class="orbit" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="#5fb3d9" stroke-opacity=".24">
        <ellipse cx="560" cy="260" rx="330" ry="330" />
        <ellipse cx="560" cy="260" rx="250" ry="330" />
        <ellipse cx="560" cy="260" rx="150" ry="330" />
        <ellipse cx="560" cy="260" rx="50" ry="330" />
        <ellipse cx="560" cy="260" rx="330" ry="110" />
        <ellipse cx="560" cy="260" rx="330" ry="220" />
      </g>
      <path id="route" d="M260 390 C 360 380, 380 250, 470 220 S 600 250, 660 170 S 760 90, 830 110"
        fill="none" stroke="#e0892b" stroke-width="2" stroke-dasharray="6 7" />
      <g fill="#e9eef2">
        <circle cx="470" cy="220" r="4" /><circle cx="660" cy="170" r="4" />
      </g>
      <path d="M8 0 L-6 -6 L-3 0 L-6 6 Z" fill="#fff">
        <animateMotion dur="14s" repeatCount="indefinite" rotate="auto"><mpath href="#route" /></animateMotion>
      </path>
    </svg>
    <div class="wrap hero-in">
      <p class="eyebrow">{site.institute[lang]}</p>
      <h1>{site.name[lang]}</h1>
      <p class="lead">{site.tagline[lang]}</p>
      <div class="cta">
        <a class="btn" href={href(lang, 'research')}>{nav[1].label[lang]} →</a>
        <a class="btn ghost" href={href(lang, 'services')}>{nav[5].label[lang]}</a>
      </div>
      <dl class="stats">
        <div><dt>{team.length}</dt><dd>{lang === 'bg' ? 'учени и инженери' : 'scientists & engineers'}</dd></div>
        <div><dt>WGS 84</dt><dd>{lang === 'bg' ? 'точни бордови модели' : 'precise on-board models'}</dd></div>
        <div><dt>NSP DS</dt><dd>{lang === 'bg' ? 'НП „Сигурност и отбрана“' : 'National Program Security & Defence'}</dd></div>
      </dl>
    </div>
  </section>

  <section class="block">
    <div class="wrap about">
      <div>
        <p class="eyebrow">{lang === 'bg' ? 'За лабораторията' : 'About'}</p>
        {site.intro[lang].map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <p class="eyebrow">{t.areasTitle[lang]}</p>
      <div class="grid cols-3">
        {areas.map((a, i) => <AreaCard lang={lang} area={a} num={i + 1} />)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap"><ClothoidDemo lang={lang} /></div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <div class="row">
        <h2>{t.latestPubs[lang]}</h2>
        <a href={href(lang, 'publications')}>{t.allPubs[lang]} →</a>
      </div>
      <PubList lang={lang} items={latest} compact />
    </div>
  </section>

  <Gallery lang={lang} />
</Layout>

<style>
  .hero { position: relative; background: var(--ink); color: #e9eef2; overflow: hidden; }
  .orbit { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (max-width: 700px) { .orbit { opacity: .35; } }
  .hero-in { position: relative; padding-top: 96px; padding-bottom: 72px; }
  .hero .eyebrow { color: var(--accent); }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); max-width: 18ch; margin: 0 0 1rem; }
  .lead { font-size: 1.2rem; color: #b9c7d3; max-width: 52ch; margin: 0 0 2rem; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .stats { display: flex; flex-wrap: wrap; gap: 40px; margin: 56px 0 0; }
  .stats div { border-left: 2px solid var(--accent); padding-left: 14px; }
  .stats dt { font: 600 1.4rem var(--mono); }
  .stats dd { margin: 0; color: #8ea3b6; font-size: .9rem; }
  .about { max-width: 820px; font-size: 1.1rem; }
  .alt { background: color-mix(in srgb, var(--line) 30%, transparent); }
  .area .num { font: 500 .8rem var(--mono); color: var(--accent-ink); display: block; margin-bottom: 10px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
</style>
