---
import Layout from '../layouts/Layout.astro';
import { team } from '../data/team/index';
import { t, type Lang } from '../data/content';
import { href } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const initials = (n: string) => n.split(' ').filter((w) => !w.endsWith('.')).map((w) => w[0]).slice(0, 2).join('');
---
<Layout lang={lang} slug="team" title={t.team[lang]}>
  <header class="page-head"><div class="wrap">
    <p class="eyebrow">URSlab</p>
    <h1>{t.team[lang]}</h1>
  </div></header>
  <section class="block help-sec"><div class="wrap">
      <div class="help-new">
        <a class="hbtn" href="/docs/URSlab-rakovodstvo.pdf" target="_blank" rel="noopener">? {lang === 'bg' ? 'Помощ за нов член на екипа' : 'Help for new team members'}</a>
        <span>{lang === 'bg'
          ? <>Ръководство: сайтът, нова публикация, обновяване (PDF) · <a href="/docs/URSlab-rakovodstvo.pptx" download>изтегли PowerPoint</a></>
          : <>Guide in Bulgarian: the site, new publication, updating (PDF) · <a href="/docs/URSlab-rakovodstvo.pptx" download>download PowerPoint</a></>}</span>
      </div>
  </div></section>
  <section class="block cards-sec"><div class="wrap grid cols-3">
    {team.map((m) => (
      <article class="card person" id={m.id}>
        <div class="top">
          {m.photo
            ? <img src={`/images/team/${m.photo}`} alt="" class="ph" />
            : <span class="ph ini">{initials(m.name[lang])}</span>}
          <div>
            <p class="ttl">{m.title[lang]}</p>
            <h3>{m.name[lang]}</h3>
            {m.role && <p class="role">{m.role[lang]}</p>}
          </div>
        </div>
        {m.thesis && <p class="thesis"><span>{lang === 'bg' ? 'Дисертация:' : 'PhD thesis:'}</span> {lang === 'bg' ? `„${m.thesis[lang]}“` : `“${m.thesis[lang]}”`}</p>}
        {m.interests && <ul class="int">{m.interests[lang].map((i) => <li>{i}</li>)}</ul>}
        <p class="rep">
          <a class="btn-rep" href={href(lang, `team/${m.id}/report`)}>{lang === 'bg' ? 'Обобщен отчет' : 'Summary report'}</a>
          {m.github && <a class="btn-rep gh" href={`${href(lang, 'publications/new')}?m=${m.id}`} title={`GitHub: ${m.github}`}>+ {lang === 'bg' ? 'Нова публикация' : 'New publication'}</a>}
        </p>
        <p class="links">
          {m.orcid && (
            <a href={`https://orcid.org/${m.orcid}`} class="orcid" title="ORCID">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#A6CE39"/><path fill="#fff" d="M7.3 7.1h1.4v10H7.3zM8 4.9a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zm2.6 2.2h3.8c3.6 0 5.2 2.6 5.2 5s-1.9 5-5.2 5h-3.8zm1.4 1.3v7.4h2.3c3.2 0 3.9-2.4 3.9-3.7 0-2.1-1.3-3.7-4-3.7z"/></svg>
              {m.orcid}
            </a>
          )}
          {m.scholar && <a href={m.scholar}>Google Scholar</a>}
          {m.researchgate && <a href={m.researchgate}>ResearchGate</a>}
          {m.dissertation && <a href={m.dissertation}>{lang === 'bg' ? 'Дисертация (НАЦИД)' : 'Dissertation (NACID register)'}</a>}
          {m.email && <a href={`mailto:${m.email}`}>{m.email}</a>}
        </p>
      </article>
    ))}
  </div></section>
</Layout>
<style>
  .help-sec { padding-bottom: 0 !important; }
  .cards-sec { padding-top: 24px !important; }
  .help-new { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; padding: 14px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .hbtn { font: 600 .9rem var(--font); padding: 9px 16px; border-radius: 8px; background: var(--accent); color: #fff; text-decoration: none; }
  .hbtn:hover { filter: brightness(1.08); }
  .help-new span { font-size: .9rem; color: var(--muted); }
  .help-new span a { color: var(--accent-ink); }
  .person { display: flex; flex-direction: column; gap: 14px; }
  .top { display: flex; gap: 14px; align-items: center; }
  .ph { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; }
  .ini { display: grid; place-items: center; background: var(--ink); color: var(--accent); font: 600 1.1rem var(--mono); }
  .ttl { margin: 0; font-size: .82rem; color: var(--muted); }
  h3 { margin: 0; }
  .role { margin: 2px 0 0; font-size: .85rem; color: var(--accent-ink); font-weight: 600; }
  .thesis { margin: 0; font-size: .88rem; font-style: italic; color: var(--muted); }
  .thesis span { font-style: normal; font-weight: 600; }
  .int { margin: 0; padding-left: 18px; font-size: .92rem; color: var(--muted); }
  .rep { margin-top: auto !important; display: flex; gap: 6px; }
  .btn-rep:only-child { flex: 0 1 calc(50% - 3px); }
  .btn-rep.gh { background: var(--ink); border-color: var(--ink); color: #fff; }
  .btn-rep.gh:hover { background: var(--accent); border-color: var(--accent); }
  .btn-rep { flex: 1 1 0; min-width: 0; display: flex; align-items: center; justify-content: center; text-align: center; font: 500 .76rem/1.25 var(--mono); padding: 7px 6px; border-radius: 8px; border: 1px solid var(--accent); color: var(--accent-ink); text-decoration: none; }
  .btn-rep:hover { background: var(--accent); color: #fff; }
  .links { display: flex; flex-direction: column; gap: 4px; font-size: .85rem; }
  .orcid { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); }
</style>
