---
import '../styles/global.css';
import { nav, site, t, type Lang } from '../data/content';
import { href } from '../lib/i18n';
import { team } from '../data/team/index';

// noindex: страницата не се индексира от търсачките (404, формата за въвеждане)
interface Props { lang: Lang; slug: string; title?: string; description?: string; noindex?: boolean }
const { lang, slug, title, description, noindex = false } = Astro.props;
const other: Lang = lang === 'bg' ? 'en' : 'bg';
const fullTitle = title ? `${title} — ${site.short[lang]}` : `${site.name[lang]} — ${site.institute[lang]}`;
const desc = description ?? site.tagline[lang];
const year = new Date().getFullYear();

// За търсачките: постоянен адрес на страницата (canonical), двете езикови версии (hreflang)
// и структурирани данни (JSON-LD) за лабораторията и колектива — на „Начало“ и „Състав“.
const abs = (l: Lang) => new URL(href(l, slug), Astro.site).href;
const canonical = abs(lang);
const ogLocale = { bg: 'bg_BG', en: 'en_US' };
const orgLd = !noindex && (slug === '' || slug === 'team') ? {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  '@id': 'https://urs.ir.bas.bg/#lab',
  name: site.name[lang],
  alternateName: [site.name[other], 'URSlab', 'БРС'],
  description: site.tagline[lang],
  url: abs(lang),
  email: site.email,
  telephone: site.phones,
  address: {
    '@type': 'PostalAddress',
    streetAddress: lang === 'bg' ? 'ул. „Акад. Г. Бончев“, бл. 2' : 'Acad. G. Bonchev St., Bl. 2',
    postalCode: '1113',
    addressLocality: lang === 'bg' ? 'София' : 'Sofia',
    addressCountry: 'BG',
  },
  parentOrganization: {
    '@type': 'ResearchOrganization',
    name: site.institute[lang],
    url: 'https://ir.bas.bg/',
    parentOrganization: { '@type': 'Organization', name: lang === 'bg' ? 'Българска академия на науките' : 'Bulgarian Academy of Sciences', url: 'https://www.bas.bg/' },
  },
  member: team.map((m) => ({
    '@type': 'Person',
    name: m.name[lang],
    honorificPrefix: m.title[lang],
    ...(m.role ? { jobTitle: m.role[lang] } : {}),
    url: `${new URL(href(lang, 'team'), Astro.site).href}#${m.id}`,
    ...(m.orcid ? { sameAs: [`https://orcid.org/${m.orcid}`] } : {}),
  })),
} : null;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="bg" href={abs('bg')} />
        <link rel="alternate" hreflang="en" href={abs('en')} />
        <link rel="alternate" hreflang="x-default" href={abs('bg')} />
      </>}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name[lang]} />
  <meta property="og:locale" content={ogLocale[lang]} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  {orgLd && <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Статистика на посещенията (GoatCounter, без бисквитки): https://urslab.goatcounter.com -->
  <script is:inline data-goatcounter="https://urslab.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap&subset=cyrillic" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href={href(lang, '')}>
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
          <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5"/>
          <path d="M4 20 C 11 20, 13 10, 20 10 S 26 14, 28 12" fill="none" stroke="#e0892b" stroke-width="2.2" stroke-linecap="round"/>
          <circle cx="20" cy="10" r="2.4" fill="#e0892b"/>
        </svg>
        <span><strong>{site.short[lang]}</strong><small>{lang === 'bg' ? 'ИР — БАН' : 'IR — BAS'}</small></span>
      </a>
      <input type="checkbox" id="navtoggle" aria-label="Menu" />
      <label for="navtoggle" class="burger" aria-hidden="true"><span></span></label>
      <nav>
        {nav.map((n) => (
          <a href={href(lang, n.slug)} aria-current={n.slug === slug || (n.slug && slug.startsWith(n.slug + '/')) ? 'page' : undefined}>{n.label[lang]}</a>
        ))}
        <a class="lang" href={href(other, slug)} hreflang={other} lang={other}>{t.switchTo[lang]}</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer>
    <div class="wrap foot">
      <div>
        <strong>{site.name[lang]}</strong>
        <p>{site.institute[lang]}<br />{site.address[lang]}</p>
      </div>
      <div>
        <p><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.phones.join(' · ')}</p>
        <p><a href="https://ir.bas.bg/">ir.bas.bg</a> · <a href="https://www.bas.bg/">bas.bg</a></p>
      </div>
    </div>
    <div class="wrap copy">© {year} {site.institute[lang]}. {t.rights[lang]}</div>
  </footer>
  <!-- Подсказки (data-tip): показват се веднага при посочване с мишката, при фокус от клавиатурата и при докосване
       (на телефон/таблет), еднакво във всеки браузър — вместо вградената подсказка на браузъра (title), която
       се появява със закъснение, не се показва след щракване или в неактивен прозорец и липсва при докосване. -->
  <div id="tip" class="tipbox" role="tooltip" hidden></div>
  <script is:inline>
    (() => {
      const box = document.getElementById('tip');
      let cur = null;
      const place = (el) => {
        const r = el.getBoundingClientRect(), m = 8;
        box.style.left = '0px'; box.style.top = '0px';
        const b = box.getBoundingClientRect();
        let x = r.left + r.width / 2 - b.width / 2;
        x = Math.max(m, Math.min(x, window.innerWidth - b.width - m));
        let y = r.bottom + m;
        if (y + b.height > window.innerHeight - m) y = Math.max(m, r.top - b.height - m);
        box.style.left = `${Math.round(x)}px`; box.style.top = `${Math.round(y)}px`;
      };
      const show = (el) => {
        cur = el; box.textContent = el.dataset.tip || ''; box.hidden = false;
        el.setAttribute('aria-describedby', 'tip'); place(el);
      };
      const hide = () => { if (cur) cur.removeAttribute('aria-describedby'); cur = null; box.hidden = true; };
      const tipOf = (t) => t instanceof Element ? t.closest('[data-tip]') : null;
      document.addEventListener('pointerover', (e) => { if (e.pointerType !== 'mouse') return; const el = tipOf(e.target); if (el && el !== cur) show(el); });
      document.addEventListener('pointerout', (e) => { if (e.pointerType !== 'mouse' || !cur) return; if (!cur.contains(e.relatedTarget)) hide(); });
      document.addEventListener('focusin', (e) => { const el = tipOf(e.target); if (el) show(el); });
      document.addEventListener('focusout', (e) => { if (cur && !cur.contains(e.relatedTarget)) hide(); });
      let wasOpen = false; // беше ли подсказката отворена преди докосването (второ докосване я затваря)
      document.addEventListener('pointerdown', (e) => { const el = tipOf(e.target); wasOpen = !!el && el === cur; });
      document.addEventListener('click', (e) => { const el = tipOf(e.target); if (el) { if (wasOpen && e.pointerType !== 'mouse') hide(); else show(el); } else hide(); wasOpen = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
      window.addEventListener('scroll', () => { if (cur) place(cur); }, { passive: true });
      window.addEventListener('resize', () => { if (cur) place(cur); });
    })();
  </script>
  <!-- Защита на снимките: без десен бутон / влачене / „Запази изображението“; голямата снимка се показва
       в прозорец на страницата като фон (не като файл, който се отваря и сваля). Сървърът (.htaccess) връща
       403 за /images/…, ако адресът се отвори директно, а не от страница на сайта. -->
  <dialog id="lb" class="lb" aria-label={lang === 'bg' ? 'Снимка' : 'Photo'}>
    <div class="lb-pic" role="img"></div>
    <p class="lb-cap"></p>
    <button type="button" class="lb-x" aria-label={lang === 'bg' ? 'Затвори' : 'Close'}>×</button>
    <button type="button" class="lb-p" aria-label={lang === 'bg' ? 'Предишна' : 'Previous'}>‹</button>
    <button type="button" class="lb-n" aria-label={lang === 'bg' ? 'Следваща' : 'Next'}>›</button>
  </dialog>
  <script is:inline>
    (() => {
      const pic = (t) => t instanceof Element && t.closest('img, picture, [data-lb], .lb-pic');
      document.addEventListener('contextmenu', (e) => { if (pic(e.target)) e.preventDefault(); });
      document.addEventListener('dragstart', (e) => { if (pic(e.target)) e.preventDefault(); });
      const d = document.getElementById('lb'), box = d.querySelector('.lb-pic'), cap = d.querySelector('.lb-cap');
      let set = [], i = 0;
      const show = () => { const b = set[i]; box.style.backgroundImage = `url("${b.dataset.lb}")`; cap.textContent = b.dataset.cap || ''; d.classList.toggle('one', set.length < 2); };
      document.addEventListener('click', (e) => {
        const b = e.target instanceof Element && e.target.closest('[data-lb]');
        if (!b) return;
        set = [...(b.parentElement?.querySelectorAll('[data-lb]') ?? [b])]; i = set.indexOf(b);
        show(); d.showModal();
      });
      const step = (k) => { i = (i + k + set.length) % set.length; show(); };
      d.querySelector('.lb-x').onclick = () => d.close();
      d.querySelector('.lb-p').onclick = () => step(-1);
      d.querySelector('.lb-n').onclick = () => step(1);
      d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
      d.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1); });
      d.addEventListener('close', () => { box.style.backgroundImage = ''; });
    })();
  </script>
</body>
</html>

<style>
  .top { background: var(--ink); color: #e9eef2; position: sticky; top: 0; z-index: 20; border-bottom: 1px solid #1e3348; }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; }
  .brand span { display: flex; flex-direction: column; line-height: 1.1; }
  .brand small { font-family: var(--mono); font-size: .7rem; color: #8ea3b6; letter-spacing: .08em; }
  nav { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
  nav a { color: #c9d5df; text-decoration: none; padding: 8px 10px; border-radius: 6px; font-size: .95rem; }
  nav a:hover { background: #1b2f45; color: #fff; }
  nav a[aria-current='page'] { color: #fff; box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }
  nav a.lang { border: 1px solid #36506a; margin-left: 8px; font-family: var(--mono); font-size: .8rem; }
  #navtoggle, .burger { display: none; }
  @media (max-width: 900px) {
    .burger { display: block; width: 40px; height: 40px; cursor: pointer; position: relative; }
    .burger span, .burger span::before, .burger span::after {
      position: absolute; left: 9px; width: 22px; height: 2px; background: #e9eef2; content: '';
    }
    .burger span { top: 19px; } .burger span::before { top: -7px; left: 0; } .burger span::after { top: 7px; left: 0; }
    nav { display: none; position: absolute; top: 64px; left: 0; right: 0; background: var(--ink); flex-direction: column; align-items: stretch; padding: 8px 16px 16px; border-bottom: 1px solid #1e3348; }
    #navtoggle:checked ~ nav { display: flex; }
    nav a.lang { margin: 8px 0 0; text-align: center; }
  }
  footer { background: var(--ink); color: #a9b8c6; margin-top: 40px; font-size: .92rem; }
  footer a { color: #e9eef2; }
  footer strong { color: #e9eef2; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; padding-top: 40px; padding-bottom: 16px; }
  .lb { padding: 0; border: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lb::backdrop { background: rgba(8, 16, 26, .92); }
  .lb-pic { position: absolute; inset: 48px 56px 56px; background: center / contain no-repeat; }
  .lb-cap { position: absolute; left: 16px; right: 16px; bottom: 14px; margin: 0; text-align: center; color: #e9eef2; font-size: .9rem; }
  .lb button { position: absolute; border: 0; background: rgba(255,255,255,.12); color: #fff; font-size: 1.8rem; line-height: 1; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; }
  .lb button:hover { background: rgba(255,255,255,.25); }
  .lb-x { top: 10px; right: 12px; }
  .lb-p { left: 8px; top: calc(50% - 22px); }
  .lb-n { right: 8px; top: calc(50% - 22px); }
  .lb.one .lb-p, .lb.one .lb-n { display: none; }
  @media (max-width: 600px) { .lb-pic { inset: 56px 8px 60px; } .lb-p, .lb-n { top: auto; bottom: 8px; } }
  .copy { border-top: 1px solid #1e3348; padding-top: 16px; padding-bottom: 28px; font-size: .8rem; }
</style>
